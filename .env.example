# ==========================================================================
# COYOTE'S HOUSE - BACKEND
# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA debe subirse al repositorio.
# ==========================================================================

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# URL base publica desde donde se sirve este backend.
# Debe coincidir EXACTAMENTE con el origen registrado en Google Cloud Console.
PUBLIC_BASE_URL=http://localhost:3000

# --- Google OAuth 2.0 ---
# Se obtienen en https://console.cloud.google.com/apis/credentials
# (ver la seccion "Configurar Google OAuth" del README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sesion ---
# Secreto para firmar el JWT de sesion. Minimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Control de acceso ---
# Correos de Google autorizados a entrar al panel, separados por coma.
# Cualquier otra cuenta de Google sera rechazada con un 403.
ADMIN_ALLOWED_EMAILS=

# --- CORS ---
# Origenes del sitio publico autorizados a consumir la API, separados por coma.
# Dejar vacio permite cualquier origen SOLO en el endpoint publico de lectura.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Almacenamiento ---
# json = los archivos de ./data SON el almacenamiento (desarrollo local, sin Neon).
# neon = Postgres en Neon es la fuente de verdad, y ./data guarda un ESPEJO que
#        se reescribe en cada guardado y es lo unico que lee el sitio publico.
#        Asi la lectura no depende de la red ni de que Neon este despierta.
# En produccion tiene que ser neon: es la copia que sobrevive a perder la VM.
STORAGE_DRIVER=json

# Carpeta del almacenamiento (json) o del espejo (neon). Por defecto ./data.
# Solo hace falta cambiarla donde el disco del proyecto sea de solo lectura
# (en Vercel: DATA_DIR=/tmp/coyote-data).
# DATA_DIR=

# Cadena de conexion de Neon. Obligatoria cuando STORAGE_DRIVER=neon.
# Las escribe `neon link` al final de este archivo; aqui quedan solo de muestra.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Rama de Neon para pruebas. NO se lee automaticamente: sirve para tener a mano
# la cadena con la que correr `npm test` sin escribir sobre production.
#   DATABASE_URL=$DATABASE_URL_TEST STORAGE_DRIVER=neon npm test
# DATABASE_URL_TEST=
